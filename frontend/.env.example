# Base URL for the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000/api

# When true, the app uses the mock service layer instead of calling FastAPI.
# This lets the full application run and demo even if hardware/backend is unavailable.
VITE_ENABLE_MOCK_API=true

# Optional: force-disable live realtime streaming attempts (falls back to demo mode)
VITE_ENABLE_REALTIME=true
